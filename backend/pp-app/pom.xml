<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>bg.petarh.piano</groupId>
        <artifactId>backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pp-app</artifactId>

    <dependencies>
        <dependency>
            <groupId>bg.petarh.piano</groupId>
            <artifactId>pp-midi-jdk</artifactId>
        </dependency>
        <dependency>
            <groupId>bg.petarh.piano</groupId>
            <artifactId>pp-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>bg.petarh.piano</groupId>
            <artifactId>pp-generator</artifactId>
        </dependency>
        <dependency>
            <groupId>bg.petarh.piano</groupId>
            <artifactId>pp-api</artifactId>
        </dependency>
        <dependency>
            <groupId>bg.petarh.piano</groupId>
            <artifactId>pp-import-midi</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>pp-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-runtime-modules</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>appimage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${antrun-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>link-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <available file="${java.home}/jmods/java.base.jmod" property="jmods.present"/>
                                        <fail unless="jmods.present"
                                              message="jlink needs the JDK's jmods, which ${java.home}/jmods lacks. On openSUSE: sudo zypper in java-25-openjdk-jmods (Fedora: java-25-openjdk-jmods, Debian/Ubuntu: openjdk-25-jmods)."/>
                                        <delete dir="${project.build.directory}/runtime"/>
                                        <exec executable="${java.home}/bin/jlink" failonerror="true">
                                            <arg value="--module-path"/>
                                            <arg value="${project.build.directory}/pp-app.jar:${project.build.directory}/lib"/>
                                            <arg value="--add-modules"/>
                                            <arg value="bg.petarh.piano.app"/>
                                            <arg value="--launcher"/>
                                            <arg value="pp=bg.petarh.piano.app/bg.petarh.piano.app.Main"/>
                                            <arg value="--strip-java-debug-attributes"/>
                                            <arg value="--no-header-files"/>
                                            <arg value="--no-man-pages"/>
                                            <arg value="--compress=zip-6"/>
                                            <arg value="--output"/>
                                            <arg value="${project.build.directory}/runtime"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
